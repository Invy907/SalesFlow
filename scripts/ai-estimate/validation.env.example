# Copy to .env.ai-validation.local in the project root. Fill in either key.
# This file contains no credentials. .env.ai-validation.local is gitignored.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: leave blank to use the same defaults as the application.
GEMINI_ESTIMATE_MODEL=
GEMINI_EXTRACTION_MODEL=
ANTHROPIC_ESTIMATE_MODEL=
ANTHROPIC_EXTRACTION_MODEL=
# Only required for Anthropic keys that need an explicit workspace.
ANTHROPIC_WORKSPACE_ID=
